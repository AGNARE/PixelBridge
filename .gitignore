# ─── Кэши и артефакты работы ────────────────────────────────────────────────
# Скачанные картинки, скриншоты, профиль Chrome. Только локальные данные,
# в репозиторий не попадают никогда.
.cache/
engine/.cache/
engine/.profile/
test/.cache/
*.log

# ─── Приватное: сессии, куки, ключи, токены ────────────────────────────────
# Профиль браузера содержит куки и сессии — это чужие данные, не для git.
.profile/
chrome-profile/
**/Cookies
**/Login Data
*.pem
*.key
.env
.env.*
!.env.example
secrets/
credentials*

# ─── Node ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ─── Python (движок раскладки в скиллах) ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ─── Редакторы и ОС ────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk
*~
*.swp
